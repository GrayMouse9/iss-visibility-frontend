{
    "swagger": "2.0",
    "info": {
        "description": "Сервис определения времени видимости МКС с Земли. Предметная услуга — точка наблюдения.",
        "title": "ISS Visibility API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3001",
    "basePath": "/api",
    "paths": {
        "/observation_points": {
            "get": {
                "description": "Опубликованные услуги с фильтром по минимальной широте. Без токена или с недействительным токеном запрос выполняется как гостевой: is_mine всегда 0.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Список точек наблюдения",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Минимальная широта, от -90 до 90",
                        "name": "min_latitude",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.ObservationPointList"
                            }
                        }
                    },
                    "400": {
                        "description": "Недопустимое значение широты"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Название и файлы. Файлы уходят в Minio, в базу попадают только ссылки. Описание задаётся при публикации.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Создание черновика",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название точки наблюдения",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение",
                        "name": "image",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Короткое видео",
                        "name": "video",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.ObservationPoint"
                        }
                    },
                    "400": {
                        "description": "Пустое название или недопустимый тип файла"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "409": {
                        "description": "Черновик уже существует"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/observation_points/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Идентификатор не указывается: черновик у пользователя может быть только один.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Черновик текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ObservationPoint"
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Черновика нет"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/observation_points/feed": {
            "get": {
                "description": "Ровно одна услуга: без параметра — первая, с after — следующая за указанной. Когда следующей нет, лента замыкается на первую. Без токена или с недействительным токеном запрос выполняется как гостевой: liked всегда 0.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Лента",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Идентификатор предыдущей показанной услуги",
                        "name": "after",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ObservationPointFeed"
                        }
                    },
                    "400": {
                        "description": "Недопустимый идентификатор"
                    },
                    "404": {
                        "description": "Опубликованных услуг нет"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/observation_points/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Логическое удаление: запись остаётся в базе со статусом «удалена».",
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Удаление услуги",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Идентификатор услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Услуга удалена"
                    },
                    "400": {
                        "description": "Недопустимый идентификатор"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Услуга не найдена или принадлежит другому пользователю"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/observation_points/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Значение 1 ставит отметку текущего пользователя, 0 снимает. Повторный вызов с тем же значением ничего не меняет.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Отметка «нравится»",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Идентификатор услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Значение отметки: 0 или 1",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.likeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ObservationPoint"
                        }
                    },
                    "400": {
                        "description": "Значение отличается от 0 и 1"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Услуга не найдена"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/observation_points/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Переводит черновик в опубликованные вместе с описанием и координатами. Статус с клиента не принимается, операция необратима.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Точки наблюдения"
                ],
                "summary": "Публикация услуги",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Идентификатор черновика",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Описание и координаты",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.publishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ObservationPoint"
                        }
                    },
                    "400": {
                        "description": "Пустое описание или координаты вне допустимых границ"
                    },
                    "401": {
                        "description": "Unauthorized"
                    },
                    "404": {
                        "description": "Черновик не найден или принадлежит другому пользователю"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users": {
            "post": {
                "description": "Создаёт пользователя. Пароль хранится только в виде bcrypt-хэша.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.registerRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.User"
                        }
                    },
                    "400": {
                        "description": "Пустой логин или пароль"
                    },
                    "409": {
                        "description": "Логин занят"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/login": {
            "post": {
                "description": "Проверяет пару логин-пароль и выдаёт JWT на срок из настроек сервиса.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Вход",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.loginResponse"
                        }
                    },
                    "400": {
                        "description": "Тело запроса не разобрано"
                    },
                    "401": {
                        "description": "Неверный логин или пароль"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/users/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Помещает предъявленный токен в чёрный список Redis до конца его срока действия.",
                "tags": [
                    "Пользователи"
                ],
                "summary": "Выход",
                "responses": {
                    "204": {
                        "description": "Токен отозван"
                    },
                    "401": {
                        "description": "Токен отсутствует, негоден или уже отозван"
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.ObservationPoint": {
            "type": "object",
            "properties": {
                "date_created": {
                    "type": "string"
                },
                "date_formed": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "likes": {
                    "type": "integer"
                },
                "longitude": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "dto.ObservationPointFeed": {
            "type": "object",
            "properties": {
                "date_created": {
                    "type": "string"
                },
                "date_formed": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "liked": {
                    "type": "integer"
                },
                "likes": {
                    "type": "integer"
                },
                "longitude": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "dto.ObservationPointList": {
            "type": "object",
            "properties": {
                "date_created": {
                    "type": "string"
                },
                "date_formed": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_mine": {
                    "type": "integer"
                },
                "latitude": {
                    "type": "number"
                },
                "likes": {
                    "type": "integer"
                },
                "longitude": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "dto.User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "is_moderator": {
                    "type": "boolean"
                },
                "login": {
                    "type": "string"
                }
            }
        },
        "handler.likeRequest": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "integer"
                }
            }
        },
        "handler.loginRequest": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "handler.loginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "handler.publishRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "latitude": {
                    "type": "number"
                },
                "longitude": {
                    "type": "number"
                }
            }
        },
        "handler.registerRequest": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Токен выдаёт POST /api/users/login. Значение заголовка — \"Bearer \u003cтокен\u003e\".",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}